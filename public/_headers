# Netlify cache headers.
#
# Astro emits no hashed asset filenames here, because the site ships no external
# JS and its CSS is inlined. That means these paths are stable, and a long cache
# on a stable filename only works if changing the file also changes its name.
#
#   To replace a font or an image that is already live, upload it under a NEW
#   filename and update site.config.js. Overwriting in place will leave repeat
#   visitors on the old copy until their cache expires.
#
# HTML is deliberately not cached. The pages are small (about 11KB over the
# wire) and content changes must appear immediately, so revalidation on every
# request is the right trade.

/fonts/*
  # Fonts never change without a rename. A year is the usual ceiling, and
  # immutable tells the browser not to even revalidate.
  Cache-Control: public, max-age=31536000, immutable

/images/*
  # Thirty days rather than a year: screenshots and client logos do get
  # replaced, and they are not renamed as reliably as fonts are.
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------------------
# Security headers.
#
# This site ships no external JavaScript and loads no third-party resources, so
# the policy can be tight. The one concession is 'unsafe-inline': Astro inlines
# both the stylesheet and the few progressive-enhancement scripts, and hashing
# them would couple this file to every build.
#
# Even with that concession the policy still blocks the things that matter: an
# injected <script src> from another origin, this site being framed for
# clickjacking, and a form being retargeted at somebody else's endpoint.
# ---------------------------------------------------------------------------

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  # Belt and braces for frame-ancestors, which older browsers ignore.
  X-Frame-Options: DENY
  # Stops a browser guessing that a .webp is really something executable.
  X-Content-Type-Options: nosniff
  # Send the full URL within the site, only the origin when leaving it.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here needs a camera, a microphone or a location.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # includeSubDomains covers downloads.glamifiedsystems.com, which is HTTPS-only
  # on R2. Do not add "preload" without deciding that separately: it is hard to
  # undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
