---
/**
 * Line icons, inline, duotone.
 *
 * Each icon is two path sets on a 24×24 grid: `main` at full strength and
 * `soft` at reduced opacity. That second layer is what stops a stroke icon
 * looking flat — it carries the secondary detail (screen chrome, gear teeth,
 * exhaust) without competing with the silhouette.
 *
 * Drawn with `currentColor`, so an icon inherits its context and works on both
 * light and inverse bands from a single definition. Inline rather than a sprite
 * or icon font: there are few enough that a request would cost more than the
 * bytes, and the CSP blocks external font hosts anyway.
 *
 * `name` comes from config. An unknown name renders nothing rather than a
 * broken glyph — a missing icon should never break a variant's build.
 */

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;

type IconDef = { main: string[]; soft?: string[] };

const ICONS: Record<string, IconDef> = {
  /* ---- services ---- */

  // Editor window with a code glyph.
  code: {
    main: ["M8.8 9.8L6 12l2.8 2.2", "M15.2 9.8L18 12l-2.8 2.2", "M13.2 8.6l-2.4 6.8"],
    soft: ["M3.5 5.5h17v13h-17z", "M3.5 8.6h17"],
  },

  // Headset: band, earcups, mic boom.
  support: {
    main: [
      "M4.2 13.5v-1.4a7.8 7.8 0 0115.6 0v1.4",
      "M4.2 12.6h1.6a1.4 1.4 0 011.4 1.4v2.6a1.4 1.4 0 01-1.4 1.4H4.2z",
      "M19.8 12.6h-1.6a1.4 1.4 0 00-1.4 1.4v2.6a1.4 1.4 0 001.4 1.4h1.6z",
    ],
    soft: ["M19.8 18v.9a2.6 2.6 0 01-2.6 2.6h-2.9", "M12.4 21.5h1.9"],
  },

  // Compass with needle and tick marks.
  compass: {
    main: ["M12 21a9 9 0 100-18 9 9 0 000 18z", "M15.7 8.3l-2.2 5.4-5.4 2.2 2.2-5.4z"],
    soft: ["M12 3v1.8M12 19.2V21M21 12h-1.8M4.8 12H3", "M12 12.6a.6.6 0 100-1.2.6.6 0 000 1.2z"],
  },

  // Receipt with torn edge and a total line.
  receipt: {
    main: ["M5.5 2.8h13v18.4l-2.2-1.5-2.2 1.5-2.1-1.5-2.2 1.5-2.1-1.5-2.2 1.5z"],
    soft: ["M9 7.4h6M9 11h6M9 14.6h3.4"],
  },

  // Pen nib with a detail line.
  pen: {
    main: ["M16.4 3.1a2.7 2.7 0 013.8 3.8L7.3 19.8 2.4 21.5 4 16.6z"],
    soft: ["M14.4 5.1l4.4 4.4", "M4 16.6l3.3 3.2"],
  },

  /* ---- process ---- */

  // Magnifier with a spark, for discovery.
  search: {
    main: ["M10.6 17.8a7.2 7.2 0 100-14.4 7.2 7.2 0 000 14.4z", "M20.6 20.6l-4.7-4.7"],
    soft: ["M7.8 10.6a2.8 2.8 0 012.8-2.8", "M18.2 3.4l.7 1.5 1.5.7-1.5.7-.7 1.5-.7-1.5-1.5-.7 1.5-.7z"],
  },

  // Gear around a target, for planning. Kept for variants that want it — at
  // badge size the radial teeth read as a sun, so `clipboard` is preferred.
  gear: {
    main: [
      "M12 15.6a3.6 3.6 0 100-7.2 3.6 3.6 0 000 7.2z",
      "M12 2.4v2.6M12 19v2.6M21.6 12H19M5 12H2.4M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9M18.8 18.8l-1.9-1.9M7.1 7.1L5.2 5.2",
    ],
    soft: ["M12 13.3a1.3 1.3 0 100-2.6 1.3 1.3 0 000 2.6z"],
  },

  // Clipboard with a check, for an agreed scope.
  clipboard: {
    main: [
      "M9 4.2H6.4a1.6 1.6 0 00-1.6 1.6v14a1.6 1.6 0 001.6 1.6h11.2a1.6 1.6 0 001.6-1.6v-14a1.6 1.6 0 00-1.6-1.6H15",
      "M9 2.6h6v3.2H9z",
    ],
    soft: ["M8.6 13.2l2.4 2.4 4.4-4.8"],
  },

  // Rocket with window and exhaust, for launch.
  rocket: {
    main: [
      "M12 2.4c2.8 2.4 4.3 5.6 4.3 9.2 0 3.1-1.5 5.4-4.3 7.4-2.8-2-4.3-4.3-4.3-7.4 0-3.6 1.5-6.8 4.3-9.2z",
      "M12 12.4a1.9 1.9 0 100-3.8 1.9 1.9 0 000 3.8z",
    ],
    soft: ["M7.9 15.1L5.4 20l3.7-1.4M16.1 15.1L18.6 20l-3.7-1.4", "M12 21.6v-1.4"],
  },

  // Two hands meeting, for delivery and support.
  handshake: {
    main: ["M2.6 12.2l4.2-4.2 3.6 3.6a1.8 1.8 0 002.6 0l4.2-4.2 4.2 4.2"],
    soft: ["M6.8 8h4.4l2 2M17.2 8h-3", "M9.4 15l2 2M13 16.4l1.6 1.6", "M2.6 12.2l3.4 3.4M21.4 12.2L18 15.6"],
  },

  /* ---- theme control ---- */

  sun: {
    main: ["M12 16.6a4.6 4.6 0 100-9.2 4.6 4.6 0 000 9.2z"],
    soft: [
      "M12 1.8v2.6M12 19.6v2.6M22.2 12h-2.6M4.4 12H1.8",
      "M19.2 4.8l-1.9 1.9M6.7 17.3l-1.9 1.9M19.2 19.2l-1.9-1.9M6.7 6.7L4.8 4.8",
    ],
  },

  moon: {
    main: ["M20.5 14.8A8.9 8.9 0 019.2 3.5a8.9 8.9 0 1011.3 11.3z"],
  },

  // Half-filled disc, for "follow the device".
  auto: {
    main: ["M12 21a9 9 0 100-18 9 9 0 000 18z"],
    soft: ["M12 3.6v16.8", "M12 5.6a6.4 6.4 0 010 12.8"],
  },

  /* ---- proof stats ---- */

  // Stacked boxes, for a count of shipped products.
  cube: {
    main: ["M12 2.6l8.2 4.7v9.4L12 21.4 3.8 16.7V7.3z"],
    soft: ["M3.8 7.3L12 12l8.2-4.7M12 12v9.4"],
  },

  // Calendar, for a founding year.
  calendar: {
    main: [
      "M4.6 4.8h14.8a1.6 1.6 0 011.6 1.6v13a1.6 1.6 0 01-1.6 1.6H4.6A1.6 1.6 0 013 19.4v-13a1.6 1.6 0 011.6-1.6z",
      "M8 2.6v4.4M16 2.6v4.4",
    ],
    soft: ["M3 10.2h18", "M7.6 14h2M11 14h2M14.4 14h2M7.6 17.4h2M11 17.4h2"],
  },

  // Map pin, for a location.
  pin: {
    main: ["M12 21.6s7-5.6 7-11.2a7 7 0 10-14 0c0 5.6 7 11.2 7 11.2z"],
    soft: ["M12 12.8a2.6 2.6 0 100-5.2 2.6 2.6 0 000 5.2z"],
  },

  /* ---- about ---- */

  // Signal with a strike-through, for offline.
  offline: {
    main: ["M12 19.6h.02", "M8.4 16.2a5 5 0 017.2 0"],
    soft: ["M4.9 12.7a10 10 0 0114.2 0", "M1.9 9.3a15 15 0 0120.2 0"],
  },

  // Shield with a check, for compliance.
  shield: {
    main: ["M12 2.4l8 3v6.2c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V5.4z"],
    soft: ["M8.7 11.9l2.4 2.4 4.2-4.6"],
  },

  // Two people, for support by the makers.
  users: {
    main: ["M9.2 11.6a3.6 3.6 0 100-7.2 3.6 3.6 0 000 7.2z", "M2.4 20.6a6.8 6.8 0 0113.6 0"],
    soft: ["M16.2 5.1a3.6 3.6 0 010 6.8", "M18.2 15.4a6.8 6.8 0 013.4 5.2"],
  },
};

const icon = ICONS[name];
---

{icon && (
  <svg
    class:list={["icon", className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {icon.soft && (
      <g class="soft">
        {icon.soft.map((d) => <path d={d} />)}
      </g>
    )}
    {icon.main.map((d) => <path d={d} />)}
  </svg>
)}

<style>
  .icon {
    display: block;
    flex: 0 0 auto;
    color: var(--band-accent, var(--accent));
  }

  .soft {
    opacity: 0.42;
  }
</style>
