---
/**
 * JSON-LD structured data.
 *
 * Tells Google what this business is, where it operates, and what each product
 * is — which is how a listing becomes a rich result rather than a plain blue
 * link. Everything here is derived from site.config.js, so it cannot drift away
 * from what the page actually says.
 *
 * Deliberately absent: aggregateRating and review. Those produce star ratings
 * in search results and must be backed by real, verifiable reviews. Inventing
 * them is a manual-action risk, not a shortcut.
 */

import site, { downloadHref } from "../lib/site";
import type { Product, Service } from "../types";

interface Props {
  /** Product page: emits SoftwareApplication. */
  product?: Product;
  /**
   * The URL the product is actually published at, where that is not
   * /products/<slug> — "/" in single-product mode, where the homepage is the
   * product page. Naming a URL that redirects elsewhere is the fastest way to
   * have a rich result declined.
   */
  productUrl?: string;
  /** Service page: emits Service. */
  service?: Service;
  /** Guide page: emits Article, attributed to the organisation. */
  article?: { slug: string; title: string; standfirst: string; seoDescription: string };
  /** Emit FAQPage from config.faq (homepage only, to avoid duplicate FAQ markup). */
  includeFaq?: boolean;
  /** Trail for BreadcrumbList, root first. */
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const { product, service, productUrl, article, includeFaq, breadcrumbs } =
  Astro.props;

const origin = site.seo.domain.replace(/\/$/, "");
const abs = (path: string) => `${origin}${path.startsWith("/") ? path : `/${path}`}`;

const organisation = {
  "@type": "Organization",
  "@id": `${origin}/#organisation`,
  name: site.legal.registeredName,
  alternateName: site.brand.company ?? site.brand.name,
  url: origin,
  logo: abs(site.brand.logo),
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.contact.city.split(",")[0]?.trim(),
    addressCountry: "ZM",
  },
  areaServed: { "@type": "Country", name: site.legal.jurisdiction },
  description: site.brand.description ?? site.seo.description,
};

const graph: Record<string, unknown>[] = [organisation];

if (product) {
  graph.push({
    "@type": "SoftwareApplication",
    name: product.name,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Windows",
    url: abs(productUrl ?? `/products/${product.slug}`),
    description: product.summary,
    image: abs(product.image),
    publisher: { "@id": `${origin}/#organisation` },
    ...(product.price && {
      offers: {
        "@type": "Offer",
        price: product.price.amount,
        priceCurrency: product.price.currency,
        availability: "https://schema.org/InStock",
        seller: { "@id": `${origin}/#organisation` },
      },
    }),
    ...(product.features?.length && { featureList: product.features }),
    /* Only emitted once there is a real host to link to. Advertising a
       downloadUrl that 404s is worse than omitting the field. */
    ...(downloadHref(product) && {
      downloadUrl: downloadHref(product),
      softwareVersion: product.download?.version,
      fileSize: product.download?.size,
    }),
  });
}

if (service) {
  graph.push({
    "@type": "Service",
    name: service.name,
    serviceType: service.name,
    url: abs(`/services/${service.slug}`),
    description: service.description ?? service.summary,
    provider: { "@id": `${origin}/#organisation` },
    areaServed: { "@type": "Country", name: site.legal.jurisdiction },
  });
}

if (article) {
  /*
   * No author person and no fabricated publish date. The organisation is the
   * author, and `dateModified` comes from legal.lastUpdated — the one date in
   * config that is actually maintained. Inventing a datePublished to decorate
   * a rich result is the sort of thing that gets a site's markup distrusted.
   */
  graph.push({
    "@type": "Article",
    headline: article.title,
    description: article.seoDescription,
    url: abs(`/guides/${article.slug}`),
    author: { "@id": `${origin}/#organisation` },
    publisher: { "@id": `${origin}/#organisation` },
    dateModified: site.legal.lastUpdated,
    inLanguage: "en",
  });
}

if (includeFaq && site.faq?.items?.length) {
  graph.push({
    "@type": "FAQPage",
    mainEntity: site.faq.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  });
}

if (breadcrumbs?.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      item: abs(crumb.path),
    })),
  });
}

/*
 * JSON.stringify does not escape "</script>", so a config string containing one
 * closes this block early and everything after it becomes live markup. Proven
 * exploitable: a brand name of `X</script><script>alert(1)</script>` executed.
 *
 * Escaping "<" as \\u003c is a valid JSON escape that no parser objects to, and
 * it makes a closing tag impossible to form. This matters more for the template
 * variants than for this site, because variant copy is not always written by
 * the person who owns the codebase.
 */
const payload = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<script type="application/ld+json" is:inline set:html={payload} />
