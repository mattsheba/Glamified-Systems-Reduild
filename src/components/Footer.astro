---
import site, { productHref, serviceHref } from "../lib/site";
import { legalDocs } from "../content/legal";

const year = new Date().getFullYear();

// Derived, not listed. Adding a legal document or a nav entry cannot leave the
// footer stale, which is the usual way a footer ends up pointing at a page that
// no longer exists.
const legal = legalDocs.map((doc) => ({ href: `/${doc.slug}`, label: doc.title }));
const quickLinks = site.nav.map((item) => ({ href: item.href, label: item.label }));

// Every product and service, by name. A footer that lists only section pages
// makes a visitor go back up a level to find anything, and gives a crawler one
// link where it could have eight.
const products = site.products.map((p) => ({ href: productHref(p.slug), label: p.name }));
const services = site.services.map((s) => ({ href: serviceHref(s.slug), label: s.name }));
---

<footer class="mode-inverse site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        {/* The supplied logo has a solid white ground, so on an inverse band it
            sits on a light chip rather than being recoloured — altering a brand
            mark is the client's call, not ours. */}
        <span class="logo-chip">
          <img src={site.brand.logo} alt={site.brand.name} width="640" height="470" />
        </span>
        <p class="muted">{site.brand.tagline}</p>
      </div>

      <div>
        <p class="eyebrow">Contact</p>
        <ul class="plain">
          <li><a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>{site.contact.phone}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li class="muted">{site.contact.city}</li>
          <li class="muted">{site.contact.hours}</li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">{site.pages?.products?.heading}</p>
        <ul class="plain">
          {products.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">{site.pages?.services?.heading}</p>
        <ul class="plain">
          {services.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      {/* The column the legal links used to occupy. Moving them to the base
          row freed it for the pages people actually want from a footer. */}
      <div>
        <p class="eyebrow">Quick links</p>
        <ul class="plain">
          {quickLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    {/* Copyright and legal share one row: both are small print, and stacking
        them wastes the full width of the footer on two short lines. */}
    <div class="footer-base">
      <p class="colophon muted">
        &copy; {year} {site.legal.registeredName}. {site.contact.city}.
      </p>

      <ul class="legal-links">
        {legal.map((doc) => (
          <li><a href={doc.href}>{doc.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Extra room at the bottom for the floating WhatsApp button, which is fixed
       over the bottom-right corner. Without it the colophon renders underneath
       the button on narrow screens, where the copyright line reaches the right
       edge. Measured: the button occupies 68px of that corner on mobile. */
    padding-block: var(--section-y) calc(var(--s-5) + 48px);
  }

  .footer-grid {
    display: grid;
    gap: var(--s-6);
    /* min(...,100%) so the track can collapse below its ideal width.
       A bare 240px minimum is a hard floor and overflows a 320px phone. */
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .logo-chip {
    display: inline-block;
    background: #fff;
    border-radius: var(--r-sm);
    padding: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .logo-chip img {
    display: block;
    height: 74px;
    width: auto;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .plain a {
    color: var(--band-ink);
    text-decoration: none;
  }

  /* Touch only. These links set at 22px, which is half a comfortable thumb
     target; the padding brings them to 44 without changing how they look on a
     mouse-driven screen. `pointer: coarse` rather than a width query, because
     what matters is the input device, not the window. */
  @media (pointer: coarse) {
    .plain a {
      display: inline-block;
      padding-block: 11px;
    }
    .plain {
      gap: 0;
    }
  }

  .plain a:hover {
    color: var(--band-accent);
  }

  /* Copyright left, legal right, wrapping to stacked when there is no room
     for both on one line. */
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--band-hairline);
  }

  .colophon {
    margin: 0;
    font-size: var(--t-meta);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    list-style: none;
    margin: 0;
    /* Clears the floating WhatsApp button, which sits over this corner. */
    padding: 0 72px 0 0;
    font-size: var(--t-meta);
  }

  .legal-links a {
    color: var(--band-ink-muted);
    text-decoration: none;
  }

  .legal-links a:hover {
    color: var(--band-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (pointer: coarse) {
    .legal-links a {
      display: inline-block;
      padding-block: 11px;
    }
  }
</style>
