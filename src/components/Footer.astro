---
import site from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="mode-inverse site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        {/* The supplied logo has a solid white ground, so on an inverse band it
            sits on a light chip rather than being recoloured — altering a brand
            mark is the client's call, not ours. */}
        <span class="logo-chip">
          <img src={site.brand.logo} alt={site.brand.name} width="640" height="470" />
        </span>
        <p class="muted">{site.brand.tagline}</p>
      </div>

      <div>
        <p class="eyebrow">Contact</p>
        <ul class="plain">
          <li><a href={`tel:${site.contact.phone.replace(/\s/g, "")}`}>{site.contact.phone}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li class="muted">{site.contact.city}</li>
          <li class="muted">{site.contact.hours}</li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">Legal</p>
        <ul class="plain">
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms of service</a></li>
          <li><a href="/refund">Refund policy</a></li>
        </ul>
      </div>
    </div>

    <p class="colophon muted">
      &copy; {year} {site.legal.registeredName}. {site.contact.city}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    /* Extra room at the bottom for the floating WhatsApp button, which is fixed
       over the bottom-right corner. Without it the colophon renders underneath
       the button on narrow screens, where the copyright line reaches the right
       edge. Measured: the button occupies 68px of that corner on mobile. */
    padding-block: var(--section-y) calc(var(--s-5) + 48px);
  }

  .footer-grid {
    display: grid;
    gap: var(--s-6);
    /* min(...,100%) so the track can collapse below its ideal width.
       A bare 240px minimum is a hard floor and overflows a 320px phone. */
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .logo-chip {
    display: inline-block;
    background: #fff;
    border-radius: var(--r-sm);
    padding: var(--s-3);
    margin-bottom: var(--s-3);
  }
  .logo-chip img {
    display: block;
    height: 74px;
    width: auto;
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  .plain a {
    color: var(--band-ink);
    text-decoration: none;
  }

  /* Touch only. These links set at 22px, which is half a comfortable thumb
     target; the padding brings them to 44 without changing how they look on a
     mouse-driven screen. `pointer: coarse` rather than a width query, because
     what matters is the input device, not the window. */
  @media (pointer: coarse) {
    .plain a {
      display: inline-block;
      padding-block: 11px;
    }
    .plain {
      gap: 0;
    }
  }

  .plain a:hover {
    color: var(--band-accent);
  }

  .colophon {
    /* Keeps the line from running under the button horizontally as well, for
       the case where it wraps differently than measured. */
    padding-right: 72px;
    margin: var(--s-6) 0 0;
    padding-top: var(--s-4);
    border-top: 1px solid var(--band-hairline);
    font-size: var(--t-meta);
  }
</style>
