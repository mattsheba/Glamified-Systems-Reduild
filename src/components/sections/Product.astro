---
/**
 * The product, in full, as a homepage band.
 *
 * Single-product mode (`productOnHome`) makes the homepage the product page,
 * so this is the detail block that would otherwise live at
 * /products/<slug> — the same component, so the two can never drift.
 *
 * Renders nothing when there is no product, which is what keeps a
 * services-only variant building (EC-2).
 */
import { soleProduct } from "../../lib/site";
import ProductDetail from "../ProductDetail.astro";

interface Props { mode: "light" | "inverse"; heading?: string }
const { mode, heading } = Astro.props;

const product = soleProduct();
---

{product && (
  <section class:list={["section", `mode-${mode}`]} id="product">
    <div class="container">
      {heading && <h2>{heading}</h2>}

      {/* The product's own lockup, above its name. The header carries the
          company mark, so without this the product is never shown as a thing
          with an identity of its own — which is what a brand search looks
          for. */}
      {product.logo && (
        <img
          class="product-mark"
          src={product.logo}
          alt={product.name}
          width="320"
          height="180"
          loading="lazy"
          decoding="async"
        />
      )}

      <ProductDetail product={product} groupHeading="h3" />
    </div>
  </section>
)}

<style>
  /* Gap belongs to the heading, not the block below it, so a band rendered
     without a heading has no dead space. */
  h2 {
    margin-bottom: var(--s-5);
  }

  .product-mark {
    display: block;
    width: auto;
    height: clamp(64px, 8vw, 96px);
    margin: 0 auto var(--s-5);
    /* The supplied lockup sits on a solid white ground, so on an inverse band
       it needs a tile rather than being recoloured — altering a mark is not
       ours to do. */
    background: #fff;
    border-radius: var(--r-sm);
    padding: var(--s-2) var(--s-3);
  }
</style>
