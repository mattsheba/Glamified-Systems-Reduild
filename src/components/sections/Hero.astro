---
import site, { whatsappHref } from "../../lib/site";

interface Props { mode: "light" | "inverse" }
const { mode } = Astro.props;

const { headline, capabilities, standfirst, primaryCta, secondaryCta, image } = site.hero;
// Either slot can be the WhatsApp action now that the hero leads with the
// products, so both resolve their href the same way.
const hrefFor = (cta: { type?: string; href?: string }) =>
  cta.type === "whatsapp" ? whatsappHref() : cta.href;
const primaryHref = hrefFor(primaryCta);
---

<section class:list={["section", "hero", `mode-${mode}`, image && "hero--image"]}>
  {/*
    The background sits in an element rather than on the section, so it can be
    faded independently of the text. A background-image with a gradient over it
    would need the gradient colours restating for every theme; a veil element
    inherits the band ground and works in both.
  */}
  {image && (
    <div class="hero-bg" aria-hidden="true">
      <img src={image} alt="" width="1600" height="900" fetchpriority="high" />
    </div>
  )}

  <div class="container hero-body">
    <p class="eyebrow">{site.brand.tagline}</p>
    <h1>{headline}</h1>

    {capabilities && capabilities.length > 0 && (
      <p class="capabilities">
        {capabilities.map((item) => <span>{item}</span>)}
      </p>
    )}

    <p class="standfirst">{standfirst}</p>

    <div class="hero-ctas">
      <a class="btn btn--primary" href={primaryHref} rel="noopener">{primaryCta.label}</a>
      {secondaryCta && (
        <a class="btn btn--ghost" href={hrefFor(secondaryCta)} rel="noopener">
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  /*
   * Sized to leave the next section visible. The hero previously ran to nearly
   * a full screen on a laptop, which hides the fact that anything follows it.
   * A cap of 78vh means the products section always shows above the fold and
   * the page reads as continuing.
   */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(var(--s-5), 4.5vw, var(--s-7));
    text-align: center;
    overflow: hidden;
  }

  .hero-body {
    position: relative;
    z-index: 1;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Centred: this frame is already 16:9, so it crops far less than the
       previous one and the laptop sits naturally right of centre where the
       veil is clearing. */
    object-position: center 42%;
    /* Visible enough to read as screenshots of real software, faint enough that
       it never competes with the headline. At 0.16 it was invisible, which is
       the same as not having it. */
    opacity: 0.62;
    filter: saturate(0.9);
  }

  /* The veil. Uses the band's own ground, so it is correct in light and dark
     without a second set of colours. Strongest behind the text, clearing
     towards the edges so the image is still legible as an image. */
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Wide and full-height rather than a circle: every line of text sits in the
       centre column, so the veil has to stay solid down the whole of it. The
       standfirst was landing at 63% of the hero, where a shorter gradient had
       already started to fade. Clearing happens left and right instead, which
       is where the screenshots read best anyway. */
    background: radial-gradient(
      70% 100% at 50% 50%,
      color-mix(in oklab, var(--band-ground, var(--ground)), transparent 12%) 35%,
      color-mix(in oklab, var(--band-ground, var(--ground)), transparent 70%) 100%
    );
  }

  /* The global `p` rule caps paragraphs at --measure with no auto margin, so
     inherited centring would centre the text inside a left-aligned box. */
  .eyebrow {
    max-width: none;
    margin: 0 auto var(--s-3);
  }

  /* Uppercase is safe here: the hero headline is a sentence, never a product
     name. The page-title component leaves it off for exactly that reason.
     22ch rather than 16: the headline is a longer sentence now, and a narrow
     measure was forcing it onto four lines on a laptop and six on a phone.
     Wider means fewer lines, which is where most of the height went. */
  h1 {
    font-size: var(--t-hero);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 22ch;
    margin: 0 auto;
  }

  /*
   * The sectors, set as separated words rather than a sentence. The separator
   * is a pseudo-element so it is never selected when the line is copied, and
   * never read aloud as punctuation.
   */
  .capabilities {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 var(--s-3);
    max-width: 44ch;
    margin: var(--s-3) auto 0;
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--band-accent, var(--accent));
  }

  .capabilities span {
    position: relative;
    white-space: nowrap;
  }

  .capabilities span + span::before {
    content: "";
    position: absolute;
    left: calc(var(--s-3) / -2);
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
    transform: translate(-50%, -50%);
  }

  .standfirst {
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--band-ink-muted, var(--ink-muted));
    max-width: 54ch;
    margin: var(--s-3) auto 0;
  }

  /*
   * The outline button is transparent with a near-white border everywhere else
   * on the site, which is fine over a plain band. Over the photograph it stopped
   * reading as a button at all: the border vanished against the laptop and the
   * label sat directly on image detail. Only here does it need a ground.
   */
  .hero--image .btn--ghost {
    background: var(--band-surface, var(--surface));
    border-color: var(--band-hairline, var(--hairline));
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-bg img {
      transition: opacity 0.3s ease;
    }
  }
</style>
