---
import site, { serviceHref } from "../../lib/site";
import Icon from "../Icon.astro";

interface Props { mode: "light" | "inverse"; heading?: string }
const { mode, heading } = Astro.props;

/*
 * Grouped where services declare a group, flat where they do not, so a variant
 * with ungrouped services renders exactly as before.
 *
 * Order follows the order services appear in config rather than an alphabetical
 * sort: the first group in the file is the one the company leads with.
 */
const groups: Array<{ name: string; items: typeof site.services }> = [];
for (const service of site.services) {
  const key = service.group ?? "";
  const found = groups.find((g) => g.name === key);
  if (found) found.items.push(service);
  else groups.push({ name: key, items: [service] });
}
const grouped = groups.some((g) => g.name);
---

<section id="services" class={`section mode-${mode}`}>
  <div class="container">
    {heading && <h2>{heading}</h2>}

    {grouped ? (
      groups.map((group) => (
        <div class="service-group">
          {group.name && <p class="eyebrow group-label">{group.name}</p>}
          <ul class="grid services" style="--col: 260px">
            {group.items.map((service) => (
              <li class="card service">
              {service.icon && <Icon name={service.icon} size={30} />}
              <h3>
                {/* Whole card is the target, via the stretched pseudo-element below. */}
                <a href={serviceHref(service.slug)}>{service.name}</a>
              </h3>
              <p class="muted">{service.summary}</p>
            </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
      <ul class="grid services" style="--col: 260px">
        {site.services.map((service) => (
          <li class="card service">
              {service.icon && <Icon name={service.icon} size={30} />}
              <h3>
                {/* Whole card is the target, via the stretched pseudo-element below. */}
                <a href={serviceHref(service.slug)}>{service.name}</a>
              </h3>
              <p class="muted">{service.summary}</p>
            </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  /*
   * A divider, not a caption. At 13px in muted grey this read as a stray label
   * and was missed entirely: the whole point is to show that the technology
   * work and the business services are two different halves of the company, so
   * it has to be visible enough to divide them.
   *
   * The rule runs from the label to the edge, which is what makes it read as a
   * section break rather than a first list item.
   */
  .group-label {
    /* The global .eyebrow caps at --measure, which stopped the rule halfway
       across for no reason anyone chose. A divider should reach the edge. */
    max-width: none;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
    color: var(--band-accent);
  }

  .group-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--band-hairline);
  }

  .service-group + .service-group {
    margin-top: var(--s-7);
  }

  h2 {
    margin-bottom: var(--s-6);
  }
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service {
    position: relative;
  }
  /* Tinted badge behind the glyph — gives the icon a footprint so the card has
     a clear entry point rather than a stroke floating in space. */
  .service :global(.icon) {
    box-sizing: border-box;
    width: 52px;
    height: 52px;
    padding: 11px;
    border-radius: var(--r-sm);
    background: var(--accent-wash);
    border: 1px solid var(--band-hairline);
    margin-bottom: var(--s-4);
  }
  .service h3 {
    font-size: var(--t-lead);
    margin-bottom: var(--s-2);
  }
  .service h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link over the whole card so the hit area matches what looks
     clickable, without nesting the paragraph inside an anchor. */
  .service h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .service:hover h3 a,
  .service:focus-within h3 a {
    color: var(--band-accent);
  }
  .service p {
    margin: 0;
  }
</style>
