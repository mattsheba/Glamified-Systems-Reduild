---
import site from "../../lib/site";
import { productHref } from "../../lib/site";

interface Props { mode: "light" | "inverse"; heading?: string }
const { mode, heading } = Astro.props;
---

<section id="products" class={`section mode-${mode}`}>
  <div class="container">
    {heading && <h2>{heading}</h2>}

    <div class="grid products" style="--col: 300px">
      {site.products.map((product) => (
        <article class="card product">
          {/* The logo carries the card where one exists; the screenshot is the
              fallback so a variant that ships only screenshots still works.
              Either way the name is in the h3 below, so the mark is decorative
              and takes an empty alt rather than repeating it to a screen
              reader. */}
          <img
            class:list={[product.logo && "is-logo"]}
            src={product.logo ?? product.image}
            alt={product.logo ? "" : `${product.name} screenshot`}
            width="1280"
            height="720"
            loading="lazy"
          />
          <h3>{product.name}</h3>
          <p class="muted">{product.summary}</p>
          <a class="product-link" href={productHref(product.slug)}>
            Read more<span class="sr-only"> about {product.name}</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Gap belongs to the heading, not the grid — a section rendered without a
     heading (as on /products, under a page header) then has no dead space. */
  h2 {
    margin-bottom: var(--s-6);
  }
  .product {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: 0;
    overflow: hidden;
  }
  /* `contain`, not `cover`: cropping a screenshot hides the thing it is there
     to show, and cropping a logo is worse still. The marks are already centred
     on a 16:9 canvas at a normalised area, so for those `contain` is a no-op
     and the three cards line up without further work here. */
  .product img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--surface-tint);
    display: block;
    padding: var(--s-2);
    border-bottom: 1px solid var(--band-hairline, var(--hairline));
  }

  /* All three marks are dark ink — navy, near-black, dark green — on
     transparency, so the tile has to stay light in both themes or they vanish.
     --logo-ground is the site's own tint rather than white: a white panel this
     size glares against a dark page. Recolouring the marks instead would mean
     altering the brand, which is not ours to do. A screenshot brings its own
     ground and needs none of this. */
  .product img.is-logo {
    background: var(--logo-ground);
    /* Smaller than it looks: the marks are centred on their own canvas with
       margin already baked in, so a large padding here doubles it and leaves
       them stranded in the middle of the tile. */
    padding: var(--s-3);
  }
  .product h3,
  .product p,
  .product .product-link {
    margin-inline: var(--s-4);
  }
  .product h3 {
    margin-top: var(--s-4);
  }
  .product p {
    flex: 1;
  }
  .product-link {
    margin-bottom: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--band-accent);
  }
  .product-link:hover {
    text-decoration: underline;
  }
</style>
