---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import site, { sectionHeading } from "../lib/site";

const copy = site.pages?.services ?? {};
const heading = copy.heading ?? site.brand.name;
---

<Base
  title={copy.seo?.title ?? `${heading} | ${site.brand.name}`}
  description={copy.seo?.description ?? copy.standfirst}
>
  <PageHeader heading={heading} standfirst={copy.standfirst} />
  <Services mode="light" />
  <Process mode="light" heading={sectionHeading("process")} />
</Base>
