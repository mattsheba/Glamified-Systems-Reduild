---
import Base from "../layouts/Base.astro";
import site from "../lib/site";
import { legalDocs } from "../content/legal";

// FR-11: /privacy, /terms, /refund — each parameterised by config.
export function getStaticPaths() {
  return legalDocs.map((doc) => ({
    params: { legal: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const updated = new Date(site.legal.lastUpdated).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base title={`${doc.title} | ${site.brand.name}`} description={`${doc.title} for ${site.legal.registeredName}.`}>
  <article class="section mode-light">
    <div class="container legal">
      <h1 class="display">{doc.title}</h1>
      {doc.standfirst && <p class="standfirst">{doc.standfirst}</p>}
      <p class="muted updated">Last updated {updated}</p>

      {doc.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
    </div>
  </article>
</Base>

<style>
  .legal {
    max-width: 72ch;
  }
  .legal h2 {
    margin-top: var(--s-6);
    margin-bottom: var(--s-2);
  }
  .updated {
    font-size: var(--t-small);
  }
  /* Deliberately loud. This should be uncomfortable to ship. */
  /* Sets the document up in a sentence before the clauses start, so the reader
     knows what they are about to read. */
  .standfirst {
    font-size: var(--t-lead);
    line-height: 1.5;
    max-width: var(--measure);
    margin: 0 0 var(--s-3);
  }
</style>
