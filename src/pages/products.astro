---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Products from "../components/sections/Products.astro";
import site from "../lib/site";

const copy = site.pages?.products ?? {};
const heading = copy.heading ?? site.brand.name;
---

<Base
  title={copy.seo?.title ?? `${heading} | ${site.brand.name}`}
  description={copy.seo?.description ?? copy.standfirst}
>
  <PageHeader heading={heading} standfirst={copy.standfirst} />
  <Products mode="light" />
</Base>
