---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import StructuredData from "../../components/StructuredData.astro";
import site, { whatsappHref, downloadHref, guideHref } from "../../lib/site";

// FR-8: one page per configured product, generated at build time.
export function getStaticPaths() {
  return site.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const wa = whatsappHref();
const download = downloadHref(product);
const guide = guideHref(product);

// Rendered only when payments are switched on AND this product has a price.
// Until then the page looks exactly as it does today.
const canBuy = Boolean(site.payments?.enabled && product.price);

// The heading leads with the problem where a headline is given; the product
// name moves to the eyebrow so the brand is still the first thing read.
const heading = product.headline ?? product.name;
const eyebrow = product.headline ? product.name : site.pages?.products?.heading;

const crumbs = [
  { name: "Home", path: "/" },
  { name: site.pages?.products?.heading ?? "Products", path: "/products" },
  { name: product.name, path: `/products/${product.slug}` },
];
---

<Base
  title={product.seo?.title ?? `${product.name} | ${site.brand.name}`}
  description={product.seo?.description ?? product.summary}
>
  <StructuredData product={product} breadcrumbs={crumbs} />
  <PageHeader heading={heading} standfirst={product.summary} eyebrow={eyebrow} />

  <section class="section mode-light">
    <div class="container">
      <img
        class="hero-shot"
        src={product.image}
        alt={`${product.name} screenshot`}
        width="1280"
        height="720"
      />

      {/* A grouped product stacks: intro across the top, capabilities in a
          two-column grid beneath. Seven groups squeezed into a side column
          would be unreadable. */}
      <div class:list={["detail", product.groups?.length && "detail--stacked"]}>
        <div class="body">
          {product.description
            .split("\n\n")
            .map((para) => <p class="intro">{para}</p>)}

          {/* Shown because the Offer in the structured data has to reflect a
              price the visitor can actually see on the page. */}
          {product.price && (
            <p class="price">
              <span class="amount">
                K{product.price.amount.toLocaleString("en-ZM")}
              </span>
              {product.price.note && <span class="note">{product.price.note}</span>}
            </p>
          )}

          {/* The installer is the primary action on a product page: someone
              reading this far wants the software, not a conversation. WhatsApp
              stays as the secondary, because buying still runs through it.
              With no download configured the WhatsApp CTA takes the primary
              slot back, so the page is never left without one. */}
          <div class="actions">
            {download ? (
              <>
                <a class="btn btn--primary btn--compact" href={download} download>
                  {site.downloads?.label}
                </a>
                {canBuy && (
                  <button class="btn btn--ghost btn--compact buy" type="button" data-buy={product.slug}>
                    {site.payments?.label}
                  </button>
                )}
                <a class="btn btn--ghost btn--compact" href={wa} rel="noopener">
                  {site.contact.ctaLabel}
                </a>
              </>
            ) : (
              <a class="btn btn--primary" href={wa} rel="noopener">
                {site.contact.ctaLabel}
              </a>
            )}
          </div>

          {/* Beside the price, not buried in a FAQ: a figure with nothing
              attached reads as more expensive than the same figure with the
              work it covers listed under it. */}
          {product.price && site.licenceIncludes && (
            <div class="includes-box">
              <p class="eyebrow">{site.licenceIncludes.label}</p>
              <ul class="includes-list">
                {site.licenceIncludes.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}

          {/* The trial is the reason someone clicks, so it sits directly under
              the button. */}
          {download && site.downloads?.trial && (
            <p class="trial">{site.downloads.trial}</p>
          )}

          {canBuy && site.payments?.note && (
            <p class="pay-note">{site.payments.note}</p>
          )}
          {canBuy && <p class="pay-status" role="status" aria-live="polite" hidden></p>}

          {/* Revealed by the buy button. Lenco needs a name, an email to send
              the key to, and a phone number for mobile money, so there is no
              way to skip collecting them. Kept inline rather than in a modal:
              a modal is more code and more ways to trap keyboard focus. */}
          {canBuy && (
            <form class="pay-form" hidden data-pay-form={product.slug}>
              <div class="pay-fields">
                <div class="field">
                  <label for={`pay-name-${product.slug}`}>{site.form.labels?.name}</label>
                  <input id={`pay-name-${product.slug}`} name="name" type="text" autocomplete="name" required />
                </div>
                <div class="field">
                  <label for={`pay-email-${product.slug}`}>{site.form.labels?.email}</label>
                  <input id={`pay-email-${product.slug}`} name="email" type="email" autocomplete="email" required />
                </div>
                <div class="field">
                  <label for={`pay-phone-${product.slug}`}>{site.form.labels?.phone}</label>
                  <input id={`pay-phone-${product.slug}`} name="phone" type="tel" autocomplete="tel" required />
                </div>
              </div>
              <button class="btn btn--primary btn--compact pay-go" type="submit">
                {site.payments?.confirmLabel}
              </button>
            </form>
          )}

          {/* A text link, not a third button. The guide is a secondary action,
              and giving it equal weight would leave no obvious primary one. */}
          {guide && site.downloads?.guideLabel && (
            <p class="guide">
              <a href={guide} target="_blank" rel="noopener">
                {site.downloads.guideLabel}
              </a>
            </p>
          )}
        </div>

        {/* Grouped capability wins where it exists. A flat list of forty items
            undersells a product this deep, because nobody reads to the end. */}
        {product.groups && product.groups.length > 0 ? (
          <div class="groups">
            {product.groups.map((group) => (
              <section class="group">
                <h2>{group.title}</h2>
                <ul class="features">
                  {group.items.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <ul class="features">
            {product.features.map((feature) => <li>{feature}</li>)}
          </ul>
        )}
      </div>
    </div>
  </section>

  {product.screenshots && product.screenshots.length > 0 && (
    <section class="section mode-light">
      <div class="container">
        <div class="grid shots" style="--col: 380px">
          {product.screenshots.map((shot) => (
            <img src={shot} alt="" width="1280" height="720" loading="lazy" class="shot" />
          ))}
        </div>
      </div>
    </section>
  )}

  {canBuy && (
    <script is:inline define:vars={{ payEndpoint: "/api/initiate-payment" }}>
      /*
       * Reveals the checkout fields, then exchanges them for a Lenco payment
       * URL and sends the customer there.
       *
       * The amount is deliberately not sent. The function looks the price up
       * from the product, so nothing here can influence what is charged.
       */
      document.querySelectorAll("[data-buy]").forEach((button) => {
        const slug = button.getAttribute("data-buy");
        const form = document.querySelector(`[data-pay-form="${slug}"]`);
        const status = document.querySelector(".pay-status");
        if (!form || !status) return;

        button.addEventListener("click", () => {
          form.hidden = false;
          button.hidden = true;
          const first = form.querySelector("input");
          if (first) first.focus();
        });

        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const go = form.querySelector(".pay-go");
          if (go.disabled) return;

          const data = new FormData(form);
          go.disabled = true;
          status.hidden = false;
          status.className = "pay-status";
          status.textContent = "Starting payment…";

          try {
            const response = await fetch(payEndpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                slug,
                name: data.get("name"),
                email: data.get("email"),
                phone: data.get("phone"),
              }),
            });
            const result = await response.json();
            if (!response.ok || !result.paymentUrl) {
              throw new Error(result.error || "Could not start payment");
            }
            // Hand off to Lenco. Nothing sensitive has been handled here.
            window.location.href = result.paymentUrl;
          } catch (error) {
            status.className = "pay-status is-error";
            status.textContent = error.message;
            go.disabled = false;
          }
        });
      });
    </script>
  )}
</Base>

<style>
  .hero-shot {
    display: block;
    width: 100%;
    max-width: 960px;
    margin: 0 auto var(--s-7);
    background: var(--surface-tint);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    padding: var(--s-2);
    object-fit: contain;
  }

  .detail {
    display: grid;
    gap: var(--s-7);
    grid-template-columns: 1.15fr 1fr;
    align-items: start;
    max-width: 960px;
    margin-inline: auto;
  }

  .includes-box {
    max-width: var(--measure);
    margin: 0 0 var(--s-5);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
  }

  .includes-list {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: var(--t-small);
  }

  .includes-list li {
    position: relative;
    padding-left: var(--s-4);
  }

  /* A tick drawn in CSS rather than a character, so it never renders as a
     tofu box on a machine without the glyph. */
  .includes-list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 9px;
    height: 5px;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    margin-top: var(--s-5);
  }

  /* The buttons carried the file size and version stacked inside them, which
     made them two lines tall and heavier than anything else on the page. The
     label alone is enough; the size is in the download itself. */
  .actions .btn--compact {
    padding: 11px 20px;
  }

  .pay-form {
    max-width: 420px;
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  .pay-fields {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .pay-form label {
    display: block;
    font-size: var(--t-small);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .pay-form input {
    width: 100%;
    padding: 10px 12px;
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
  }

  .pay-form input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .pay-note,
  .pay-status {
    max-width: var(--measure);
    margin: var(--s-2) 0 0;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .pay-status.is-error {
    color: var(--error);
  }

  .guide {
    margin: var(--s-2) 0 0;
    font-size: var(--t-small);
  }

  .guide a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  /* Carries the accent so it reads as an offer, not a disclaimer. */
  .trial {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    max-width: var(--measure);
    margin: var(--s-3) 0 0;
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }

  .trial::before {
    content: "";
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-1px);
  }

  /* Runs the full width of .detail rather than the global 68ch measure, so the
     right edge meets the screenshot sitting directly above it. The gap was
     130px, and justification made it read worse rather than better: squaring
     the copy off into a hard edge only drew attention to the fact that the
     edge did not line up with the image's.

     On the stacked layout that takes the measure to roughly 79ch, a little
     past the site default — acceptable for three-line paragraphs, and the
     alignment buys more than the extra characters cost. The two-column layout
     is unaffected: its body column is narrower than 68ch already, so the cap
     was never what constrained it. */
  .intro {
    font-size: var(--t-lead);
    line-height: 1.55;
    margin-bottom: var(--s-5);
    max-width: none;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }
  .price .amount {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }
  .price .note {
    font-size: var(--t-small);
    color: var(--ink-muted);
  }

  .detail--stacked {
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  .groups {
    display: grid;
    gap: var(--s-6) var(--s-7);
    /* min(...,100%) so the track can collapse below its ideal width.
       A bare 300px minimum is a hard floor and overflows a 320px phone. */
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }

  @media (max-width: 767px) {
    .groups {
      gap: var(--s-5) var(--s-7);
    }
    .detail--stacked {
      gap: var(--s-5);
    }
    .hero-shot {
      margin-bottom: var(--s-5);
    }
  }

  .group h2 {
    font-size: var(--t-h3);
    padding-bottom: var(--s-2);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--hairline);
  }

  .features {
    margin: 0;
    padding-left: var(--s-3);
  }
  .features li {
    margin-bottom: var(--s-2);
  }
  .features li::marker {
    color: var(--accent);
  }

  .shot {
    width: 100%;
    background: var(--surface);
    border-radius: var(--r-sm);
    padding: var(--s-1);
    object-fit: contain;
  }

  @media (max-width: 1024px) {
    .detail {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }
</style>
