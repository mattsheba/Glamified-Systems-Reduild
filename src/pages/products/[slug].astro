---
/**
 * /products/<slug> — one page per configured product (FR-8).
 *
 * In single-product mode this route is a leftover: the homepage carries the
 * product, public/_redirects force-301s this path to "/", and the page is
 * built only because the engine serves variants that really do have several
 * products. It renders noindex in that mode so that if a crawler reaches it
 * past the redirect, it is not treated as a second copy of the homepage.
 */
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import StructuredData from "../../components/StructuredData.astro";
import ProductDetail from "../../components/ProductDetail.astro";
import site, { productsHref } from "../../lib/site";

export function getStaticPaths() {
  return site.products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// The heading leads with the problem where a headline is given; the product
// name moves to the eyebrow so the brand is still the first thing read.
const heading = product.headline ?? product.name;
const eyebrow = product.headline ? product.name : site.pages?.products?.heading;

const crumbs = [
  { name: "Home", path: "/" },
  { name: site.pages?.products?.heading ?? "Products", path: productsHref() },
  { name: product.name, path: `/products/${product.slug}` },
];
---

<Base
  title={product.seo?.title ?? `${product.name} | ${site.brand.name}`}
  description={product.seo?.description ?? product.summary}
  noindex={site.productOnHome}
>
  {/* Nothing structured is emitted while this page is a redirect target: the
      homepage already carries the product's SoftwareApplication markup, and
      two of them describing one product is the drift this avoids. */}
  {!site.productOnHome && (
    <StructuredData product={product} breadcrumbs={crumbs} />
  )}

  <PageHeader heading={heading} standfirst={product.summary} eyebrow={eyebrow} />

  <section class="section mode-light">
    <div class="container">
      <ProductDetail product={product} />
    </div>
  </section>
</Base>
